        <mxCell id="legend-bg" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#EDF3FF,#263947);strokeColor=#6C8EBF;verticalAlign=top;fontStyle=1;fontSize=16;fontColor=light-dark(#232F3E,#FFFFFF);fontFamily=Helvetica;shadow=1;" value="Request flow" vertex="1">
          <mxGeometry x="1280" y="125" width="475" height="790" as="geometry" />
        </mxCell>
        <mxCell id="legend-1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontFamily=Helvetica;fontColor=light-dark(#232F3E,#FFFFFF);" value="&lt;b&gt;1. Invoke Runtime&lt;/b&gt;&lt;br&gt;The local CLI sends document names to AgentCore Runtime using AWS SigV4." vertex="1">
          <mxGeometry x="1310" y="175" width="410" height="72" as="geometry" />
        </mxCell>
        <mxCell id="legend-2" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontFamily=Helvetica;fontColor=light-dark(#232F3E,#FFFFFF);" value="&lt;b&gt;2. Obtain OAuth token&lt;/b&gt;&lt;br&gt;Runtime uses Cognito client credentials for Gateway access." vertex="1">
          <mxGeometry x="1310" y="262" width="410" height="72" as="geometry" />
        </mxCell>
        <mxCell id="legend-3" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontFamily=Helvetica;fontColor=light-dark(#232F3E,#FFFFFF);" value="&lt;b&gt;3. Open MCP session&lt;/b&gt;&lt;br&gt;Runtime calls AgentCore Gateway with the bearer token; Gateway validates the JWT." vertex="1">
          <mxGeometry x="1310" y="349" width="410" height="72" as="geometry" />
        </mxCell>
        <mxCell id="legend-4" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontFamily=Helvetica;fontColor=light-dark(#232F3E,#FFFFFF);" value="&lt;b&gt;4. Invoke content tools&lt;/b&gt;&lt;br&gt;Gateway dispatches get_document and get_guideline to its Lambda target." vertex="1">
          <mxGeometry x="1310" y="436" width="410" height="72" as="geometry" />
        </mxCell>
        <mxCell id="legend-5" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontFamily=Helvetica;fontColor=light-dark(#232F3E,#FFFFFF);" value="&lt;b&gt;5. Retrieve source content&lt;/b&gt;&lt;br&gt;Lambda reads bundled Markdown by exact filename and returns stable line coordinates." vertex="1">
          <mxGeometry x="1310" y="523" width="410" height="72" as="geometry" />
        </mxCell>
        <mxCell id="legend-6" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontFamily=Helvetica;fontColor=light-dark(#232F3E,#FFFFFF);" value="&lt;b&gt;6. Analyze, review, resolve&lt;/b&gt;&lt;br&gt;The stateful handler calls stateless reviewer and resolver tools; all use the Bedrock model." vertex="1">
          <mxGeometry x="1310" y="610" width="410" height="72" as="geometry" />
        </mxCell>
        <mxCell id="legend-7" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontFamily=Helvetica;fontColor=light-dark(#232F3E,#FFFFFF);" value="&lt;b&gt;7. Persist the report&lt;/b&gt;&lt;br&gt;Runtime returns validated JSON and the CLI writes Markdown and JSON artifacts locally." vertex="1">
          <mxGeometry x="1310" y="697" width="410" height="72" as="geometry" />
        </mxCell>
